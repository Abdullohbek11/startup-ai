generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("user") // 'user' | 'admin' | 'advertiser'
  city           String
  emailVerifiedAt DateTime?
  isBlocked      Boolean  @default(false)
  createdAt      DateTime @default(now())

  ideas          StartupIdea[]
  advertiserProfile AdvertiserProfile?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  chatSessions   ChatSession[]

  @@index([email])
}

model StartupIdea {
  id             String   @id @default(cuid())
  user           User?    @relation(fields: [userId], references: [id])
  userId         String?
  ideaText       String
  city           String
  businessType   String
  analysisResult Json
  score          Int
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([city])
}

model AdvertiserProfile {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id])
  userId      String          @unique
  companyName String
  description String
  phone       String
  website     String?
  city        String

  advertisements Advertisement[]
}

model Advertisement {
  id          String   @id @default(cuid())
  advertiser  AdvertiserProfile @relation(fields: [advertiserId], references: [id])
  advertiserId String
  title       String
  description String
  category    String   // 'suppliers' | 'equipment' | ...
  price       Int
  city        String
  status      String   @default("pending") // 'pending' | 'approved' | 'rejected'
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([advertiserId])
  @@index([city])
  @@index([status])
  @@index([category])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([token])
}

model ChatSession {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  ChatMessage[]

  @@index([userId, createdAt])
}

model ChatMessage {
  id        String       @id @default(cuid())
  session   ChatSession  @relation(fields: [sessionId], references: [id])
  sessionId String
  role      String
  content   String
  createdAt DateTime     @default(now())

  @@index([sessionId, createdAt])
}


